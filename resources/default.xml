<?xml version="1.0" encoding="utf-8"?>
<MMI>
  <Strings>
    <Common>
      <Empty>Empty</Empty>
    </Common>
    <Update>
      <UpdateAvailable>Update available!</UpdateAvailable>
      <UpdateText>A new version of Mors Mutual Insurance Single Player is available!</UpdateText>
    </Update>
    <Agency>
      <AgencyEntry>Press ~INPUT_CONTEXT~ to enter.</AgencyEntry>
      <AgencyEntryWanted>You cannot enter the building while wanted.</AgencyEntryWanted>
    </Agency>
    <Menus>
      <!-- Insure vehicle -->
      <InsureVehicle>Insure my current vehicle</InsureVehicle>
      <InsureVehicleDesc>Insure the last vehicle you've entered:</InsureVehicleDesc>
      <VehicleWrongType>We are unable to insure this kind of vehicle:</VehicleWrongType>
      <VehicleAlreadyInsured>This vehicle is already insured:</VehicleAlreadyInsured>
      <NotifyVehicleIsInsured>This vehicle ~b~$VehicleFriendlyName~w~ is now insured.</NotifyVehicleIsInsured>
      <NotifyInsureNoMoney>You don't have enought money to insure this vehicle.</NotifyInsureNoMoney>

      <!-- Cancel contract -->
      <CancelInsurance>Cancel a contract</CancelInsurance>
      <CancelInsuranceDesc>Cancel the contract of a vehicle.</CancelInsuranceDesc>
      <CancelInsuranceItemDesc>This vehicle won't be insured anymore.</CancelInsuranceItemDesc>
      <CancelInsuranceItemEmptyDesc>You don't have any insured vehicle.</CancelInsuranceItemEmptyDesc>
      <NotifyCanceled>This vehicle is not insured anymore.</NotifyCanceled>

      <!-- Recover vehicle -->
      <RecoverVehicle>Recover a destroyed vehicle</RecoverVehicle>
      <RecoverVehicleDesc>Recover any of your insured destroyed vehicles.</RecoverVehicleDesc>
      <RecoverVehicleItemEmptyDesc>There are no destroyed vehicles.</RecoverVehicleItemEmptyDesc>

      <!-- Stolen vehicle -->
      <StolenVehicle>Report a stolen vehicle</StolenVehicle>
      <StolenVehicleDesc>Recover a vehicle that has disappeared.</StolenVehicleDesc>
      <StolenVehicleItemEmptyDesc>You don't have any insured vehicle.</StolenVehicleItemEmptyDesc>

      <!-- Bring the vehicle -->
      <BringVehicle>Bring me my vehicle</BringVehicle>
      <BringVehicleDesc>Brings the vehicle to you.</BringVehicleDesc>
      <BringVehicleItemEmptyDesc>You don't have any recovered vehicle.</BringVehicleItemEmptyDesc>
      <NotifyBringVehicle>Our driver is coming at you.</NotifyBringVehicle>
      <NotifyBringVehicleCancel>Sorry but aren't able to deliver your vehicle at the moment. You have been refunded.</NotifyBringVehicleCancel>

      <!-- Common -->
      <NotifyDeliverVehicle>Your vehicle will be delivered at the Mors Mutual depot.</NotifyDeliverVehicle>
      <NotifyDeliverVehicle>Your replacement vehicle can be found at the Mors Mutual depot.</NotifyDeliverVehicle>
      <NotifyNoMoney>You don't have enough money.</NotifyNoMoney>
    </Menus>
    <UpdateInsurance>
      <NotifyVehicleDestroyedTitle>Information</NotifyVehicleDestroyedTitle>
      <NotifyVehicleDestroyedSubtitle>Your Personal Vehicle has been destroyed. You can call Mors Mutual Insurance to make a claim.</NotifyVehicleDestroyedSubtitle>
      <NotifyVehicleRecoveredTitle>IMPORTANT</NotifyVehicleRecoveredTitle>
      <NotifyVehicleRecoveredSubtitle>You need to ~h~store your vehicle~h~ in your garage to avoid any problem.</NotifyVehicleRecoveredSubtitle>
    </UpdateInsurance>
    <MenuConfig>
      <ConfigMenuTitle>MMI Configuration</ConfigMenuTitle>
      <ConfigMenuSubtitle>Settings</ConfigMenuSubtitle>
      <ConfigMenuContact>MMI Settings</ConfigMenuContact>
      <ConfigMenuItemGeneral>General</ConfigMenuItemGeneral>
      <ConfigMenuGeneralLanguage>Language</ConfigMenuGeneralLanguage>
      <ConfigMenuGeneralPersistent>Persistent insured vehicles</ConfigMenuGeneralPersistent>
      <ConfigMenuItemNotify>Notifications</ConfigMenuItemNotify>
      <ConfigMenuNotifyUpdate>Check for update</ConfigMenuNotifyUpdate>
      <ConfigMenuNotifySHVDN>ScriptHookVDotNet notification</ConfigMenuNotifySHVDN>
      <ConfigMenuNotifyFile>Missing file notification</ConfigMenuNotifyFile>
      <ConfigMenuNotifyVisualC>Visual C++ notification</ConfigMenuNotifyVisualC>
      <ConfigMenuNotifyNET>.NET Framework notification</ConfigMenuNotifyNET>
      <ConfigMenuNotifyReboot>Restart the game to apply changes.</ConfigMenuNotifyReboot>
      <ConfigMenuItemInsurance>Insurance</ConfigMenuItemInsurance>
      <ConfigMenuInsuranceInsurance>Insure cost multiplier</ConfigMenuInsuranceInsurance>
      <ConfigMenuInsuranceInsuranceEx>(base cost x multiplier)</ConfigMenuInsuranceInsuranceEx>
      <ConfigMenuInsuranceRecover>Recover cost multiplier</ConfigMenuInsuranceRecover>
      <ConfigMenuInsuranceRecoverEx>(base cost x multiplier)</ConfigMenuInsuranceRecoverEx>
      <ConfigMenuInsuranceStolen>Stolen cost multiplier</ConfigMenuInsuranceStolen>
      <ConfigMenuInsuranceStolenEx>(base cost x multiplier)</ConfigMenuInsuranceStolenEx>
      <ConfigMenuItemBringVehicle>Bring Vehicle</ConfigMenuItemBringVehicle>
      <ConfigMenuBringVehiclePrice>Base price</ConfigMenuBringVehiclePrice>
      <ConfigMenuBringVehicleRadius>Radius</ConfigMenuBringVehicleRadius>
      <ConfigMenuBringVehicleTimeout>Timeout (seconds)</ConfigMenuBringVehicleTimeout>
      <ConfigMenuBringVehicleInstantTrue>Instant: Yes</ConfigMenuBringVehicleInstantTrue>
      <ConfigMenuBringVehicleInstantFalse>Instant: No</ConfigMenuBringVehicleInstantFalse>
      <ConfigMenuiFruitPhoneVolume>Phone volume</ConfigMenuiFruitPhoneVolume>
      <ConfigMenuiFruitInsure>Insure via phone</ConfigMenuiFruitInsure>
      <ConfigMenuiFruitCancel>Cancel via phone</ConfigMenuiFruitCancel>
      <ConfigMenuiFruitRecover>Recover via phone</ConfigMenuiFruitRecover>
      <ConfigMenuiFruitStolen>Report stolen via phone</ConfigMenuiFruitStolen>
      <ConfigMenuiFruitPlate>Change plate via phone</ConfigMenuiFruitPlate>
    </MenuConfig>
    <PlateChange>
      <PlateChange>Change license plate</PlateChange>
      <PlateChangeDesc>Change the license plate of an insured vehicle.</PlateChangeDesc>
      <PlateChangeItemEmptyDesc>You don't have any insured vehicle.</PlateChangeItemEmptyDesc>
      <PlateChangeUpdateDB>Updating database</PlateChangeUpdateDB>
      <PlateChangeUpdateDBDesc>Please wait...</PlateChangeUpdateDBDesc>
      <NotifyPlateChanged>License plate changed</NotifyPlateChanged>
      <NotifyWrongPlate>Invalid plate format.</NotifyWrongPlate>
    </PlateChange>
  </Strings>
</MMI>